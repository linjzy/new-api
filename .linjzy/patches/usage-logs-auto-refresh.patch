+along with this program. If not, see <https://www.gnu.org/licenses/>.
+
+For commercial licensing, please contact support@quantumnous.com
+*/
+import { USAGE_LOGS_AUTO_REFRESH_INTERVAL_MS } from '../constants'
+
+type UsageLogsQueryStatus = 'pending' | 'error' | 'success'
+
+export const USAGE_LOGS_AUTO_REFRESH_ERROR_TOAST_ID =
+  'usage-logs-auto-refresh-error'
+
+export function getUsageLogsRefetchInterval(
+  autoRefresh: boolean,
+  page: number,
+  queryStatus: UsageLogsQueryStatus
+): number | false {
+  if (!autoRefresh || page !== 1 || queryStatus === 'error') {
+    return false
+  }
+  return USAGE_LOGS_AUTO_REFRESH_INTERVAL_MS
+}
