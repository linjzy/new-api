+		`{"type":"response.reasoning_summary_part.added","part":{"type":"summary_text","text":""}}`,
+		`{"type":"response.created","response":{"output":[],"usage":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"cached_tokens":0}}}}`,
