+func TestResponsesCapacityFailureClassification(t *testing.T) {
+	cases := []struct {
+		name, event string
+		retry       bool
+	}{
+		{"nested capacity", capacityFailed, true},
+		{"codex overload", `{"type":"response.failed","response":{"error":{"code":"server_is_overloaded","message":"busy"}}}`, true},
+		{"top level error", `{"type":"error","code":"slow_down","message":"busy"}`, true},
+		{"nested event error", `{"type":"response.error","error":{"code":"rate_limit_exceeded","message":"busy"}}`, true},
+		{"message only", `{"type":"response.failed","response":{"error":{"message":"Selected model is at capacity. Please try a different model."}}}`, true},
+		{"context length", `{"type":"response.failed","response":{"error":{"code":"context_length_exceeded","message":"too long"}}}`, false},
+		{"do not override explicit error", `{"type":"error","code":"invalid_prompt","message":"Selected model is at capacity"}`, false},
+		{"status failed", `{"type":"response.done","response":{"status":"failed","error":{"code":"model_at_capacity","message":"busy"}}}`, true},
+		{"failed with empty reasoning item", `{"type":"response.failed","response":{"output":[{"type":"reasoning","summary":[],"encrypted_content":null}],"error":{"code":"model_at_capacity"}}}`, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c, recorder, resp, info := capacityStreamContext(t, io.NopCloser(strings.NewReader(capacitySSE(capacityCreated, capacityInProgress, capacityEmptyReasoning, tc.event))))
+			usage, apiErr := openai.OaiResponsesStreamHandler(c, info, resp)
+			require.NotNil(t, apiErr)
+			assert.Equal(t, tc.retry, shouldRetry(c, apiErr, 2))
+			assert.False(t, shouldRetry(c, apiErr, 0))
+			assert.False(t, c.Writer.Written())
+			assert.Empty(t, recorder.Body.String())
+			assert.Empty(t, recorder.Header().Get("X-Codex-Turn-State"))
+			assert.Zero(t, usage.TotalTokens)
+			assert.Equal(t, relaycommon.StreamEndReasonUpstreamError, info.StreamStatus.EndReason)
+			assert.True(t, info.StreamStatus.HasErrors())
+		})
+	}
+}
