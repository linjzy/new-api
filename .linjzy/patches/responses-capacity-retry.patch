+func TestResponsesCapacityAfterOutputDoesNotReplay(t *testing.T) {
+	for _, event := range []string{
+		`{"type":"response.output_text.delta","delta":"hello"}`,
+		`{"type":"response.output_item.added","item":{"type":"function_call","id":"fc1","call_id":"call1","name":"run","arguments":""}}`,
+		`{"type":"response.reasoning_summary_text.delta","delta":"thinking"}`,
+		`{"type":"response.output_item.added","item":{"type":"reasoning","summary":[],"encrypted_content":"already-produced"}}`,
+		`{"type":"response.output_item.added","item":{"type":"reasoning","summary":[{"type":"summary_text","text":"thinking"}]}}`,
+		`{"type":"response.output_item.added","item":{"type":"message","content":[{"type":"output_text","text":"hello"}]}}`,
+		`{"type":"response.output_item.added","item":{"type":"reasoning","new_extension":"unknown work"}}`,
+	} {
+		t.Run(event, func(t *testing.T) {
+			c, recorder, resp, info := capacityStreamContext(t, io.NopCloser(strings.NewReader(capacitySSE(capacityCreated, event, capacityFailed))))
+			_, apiErr := openai.OaiResponsesStreamHandler(c, info, resp)
+			require.NotNil(t, apiErr)
+			assert.True(t, c.Writer.Written())
+			assert.False(t, shouldRetry(c, apiErr, 2))
+			assert.Equal(t, 1, strings.Count(recorder.Body.String(), "data: "+capacityFailed))
+			assert.Contains(t, recorder.Body.String(), event)
+			assert.True(t, common.GetContextKeyBool(c, constant.ContextKeyResponsesStreamFailed))
+		})
+	}
+}
