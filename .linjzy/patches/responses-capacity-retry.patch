+func TestResponsesCapacityRelayFailoverAndAffinity(t *testing.T) {
+	// Other controller tests start long-lived background workers. Run this
+	// real relay/billing fixture in its own process so all of its async refunds
+	// can finish before the fixture replaces databases and global settings.
+	if os.Getenv("NEWAPI_CAPACITY_ISOLATED") != "1" {
+		command := exec.Command(os.Args[0], "-test.run=^TestResponsesCapacityRelayFailoverAndAffinity$", "-test.timeout=60s", "-test.v")
+		command.Env = append(os.Environ(), "NEWAPI_CAPACITY_ISOLATED=1")
+		output, err := command.CombinedOutput()
+		require.NoError(t, err, "%s", output)
+		return
+	}
+	require.Eventually(t, func() bool { return gopool.WorkerCount() == 0 }, 5*time.Second, time.Millisecond)
+	// Sequential key retirement initializes the notification limiter's
+	// long-lived cleanup worker. Keep that stable worker out of billing waits.
+	savedRedis := common.RedisEnabled
+	common.RedisEnabled = false
+	t.Cleanup(func() { common.RedisEnabled = savedRedis })
+	_, err := service.CheckNotificationLimit(0, "capacity-test-fixture")
+	require.NoError(t, err)
+	backgroundWorkers := gopool.WorkerCount()
+	for _, tc := range []struct {
+		name                                                           string
+		allFail, partial, billed, cache, samePriority, switchOnSuccess bool
+		zeroUsage, toolFailure, sequential, afterCapacity              bool
+	}{
+		{name: "failover"}, {name: "all full", allFail: true},
+		{name: "partial output", partial: true}, {name: "billed failure", billed: true},
+		{name: "cached failover", cache: true}, {name: "same priority", allFail: true, samePriority: true},
+		{name: "cached same priority", allFail: true, samePriority: true, cache: true},
+		{name: "switch affinity on success", switchOnSuccess: true},
+		{name: "committed zero usage failure", zeroUsage: true},
+		{name: "committed tool-only failure", toolFailure: true},
+		{name: "sequential keys preserve failover budget", sequential: true},
+		{name: "cached sequential keys preserve failover budget", sequential: true, cache: true},
+		{name: "sequential keys after capacity failure", sequential: true, afterCapacity: true},
+		{name: "cached sequential keys after capacity failure", sequential: true, afterCapacity: true, cache: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db := capacityRelayTestDB(t)
+			require.NoError(t, db.AutoMigrate(&model.Log{}, &model.Token{}, &model.UserSubscription{}, &model.SubscriptionPlan{}))
+			require.NoError(t, db.Create(&model.User{Id: 1, Username: "capacity-test", Group: "default", Quota: 1000000}).Error)
+			require.NoError(t, db.Create(&model.Token{Id: 1, UserId: 1, Key: "capacity-test", UnlimitedQuota: true}).Error)
+			cacheEnabled, retries, errorLog, countToken := common.MemoryCacheEnabled, common.RetryTimes, constant.ErrorLogEnabled, constant.CountToken
