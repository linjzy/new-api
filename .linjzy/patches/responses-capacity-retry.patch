+// NEWAPI_CAPACITY_TEST_DSN opts into the CI matrix's empty, disposable database.
+// Refuse existing application tables; only tables created here are removed.
+func capacityRelayTestDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	if dsn := os.Getenv("NEWAPI_CAPACITY_TEST_DSN"); dsn != "" {
+		t.Setenv("SQL_DSN", dsn)
+		t.Setenv("LOG_SQL_DSN", "")
+		savedMaster, savedRedis := common.IsMasterNode, common.RedisEnabled
+		common.IsMasterNode, common.RedisEnabled = false, false
+		t.Cleanup(func() { common.IsMasterNode, common.RedisEnabled = savedMaster, savedRedis })
+		require.NoError(t, model.InitDB())
+		db := model.DB
+		model.LOG_DB = db
+		tables := []any{&model.User{}, &model.Channel{}, &model.Ability{}, &model.Model{}, &model.Vendor{}, &model.Log{}, &model.Token{}, &model.UserSubscription{}, &model.SubscriptionPlan{}}
+		for _, table := range tables {
+			require.False(t, db.Migrator().HasTable(table), "database must be empty and disposable")
+		}
+		require.NoError(t, db.AutoMigrate(tables...))
+		t.Cleanup(func() {
+			require.NoError(t, db.Migrator().DropTable(tables...))
+			sqlDB, err := db.DB()
+			require.NoError(t, err)
+			require.NoError(t, sqlDB.Close())
+		})
+		return db
+	}
+	return setupModelListControllerTestDB(t)
+}
