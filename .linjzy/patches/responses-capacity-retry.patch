+const capacityCreated = `{"type":"response.created","response":{"id":"failed-attempt","status":"in_progress","output":[],"usage":null}}`
+const capacityInProgress = `{"type":"response.in_progress","response":{"id":"failed-attempt","status":"in_progress","output":[],"usage":null}}`
+const capacityEmptyReasoning = `{"type":"response.output_item.added","item":{"id":"rs-empty","type":"reasoning","summary":[],"encrypted_content":null}}`
+const capacityFailed = `{"type":"response.failed","response":{"id":"failed-attempt","status":"failed","error":{"type":"server_error","code":"model_at_capacity","message":"Selected model is at capacity. Please try a different model."}}}`
+const capacityCompleted = `{"type":"response.completed","response":{"id":"successful-attempt","status":"completed","output":[],"usage":{"input_tokens":10,"output_tokens":2,"total_tokens":12}}}`
+
+func capacitySSE(events ...string) string {
+	return "data: " + strings.Join(events, "\n\ndata: ") + "\n\n"
+}
