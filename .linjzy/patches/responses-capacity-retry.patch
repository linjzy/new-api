+func TestResponsesCapacityStreamBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		events  []string
+		written bool
+	}{
+		{"empty EOF", nil, false},
+		{"prelude EOF", []string{capacityCreated}, false},
+		{"malformed", []string{capacityCreated, "not JSON"}, false},
+		{"output in failed response", []string{`{"type":"response.failed","response":{"output":[{"type":"function_call","call_id":"call1","name":"run","arguments":"{}"}],"error":{"code":"model_at_capacity"}}}`}, true},
+		{"encrypted output in failed response", []string{`{"type":"response.failed","response":{"output":[{"type":"reasoning","summary":[],"encrypted_content":"already-produced"}],"error":{"code":"model_at_capacity"}}}`}, true},
+		{"bounded event count", append(strings.Split(strings.TrimSpace(strings.Repeat(capacityCreated+"\n", 17)), "\n"), capacityFailed), true},
+		{"bounded bytes", []string{strings.Replace(capacityCreated, "failed-attempt", strings.Repeat("x", 2<<20), 1), capacityFailed}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c, _, resp, info := capacityStreamContext(t, io.NopCloser(strings.NewReader(capacitySSE(tc.events...))))
+			_, apiErr := openai.OaiResponsesStreamHandler(c, info, resp)
+			require.NotNil(t, apiErr)
+			assert.Equal(t, tc.written, c.Writer.Written())
+			assert.False(t, shouldRetry(c, apiErr, 2))
+		})
+	}
+	t.Run("prelude deadline", func(t *testing.T) {
+		synctest.Test(t, func(t *testing.T) {
+			reader, writer := io.Pipe()
+			defer writer.Close()
+			c, _, resp, info := capacityStreamContext(t, reader)
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				for {
+					if _, err := io.WriteString(writer, ": heartbeat\n\n"); err != nil {
+						return
+					}
+					time.Sleep(time.Second)
+				}
+			}()
+			_, apiErr := openai.OaiResponsesStreamHandler(c, info, resp)
+			<-done
+			require.NotNil(t, apiErr)
+			assert.Equal(t, 504, apiErr.StatusCode)
+			assert.False(t, c.Writer.Written())
+			assert.False(t, shouldRetry(c, apiErr, 2))
+			assert.Equal(t, relaycommon.StreamEndReasonTimeout, info.StreamStatus.EndReason)
+		})
+	})
+}
