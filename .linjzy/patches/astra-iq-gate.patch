+package model
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm/clause"
+)
+
+const astraIQSettingsKey = "AstraIQSettings"
+
+var astraIQTimezone = time.FixedZone("Asia/Shanghai", 8*60*60)
+
+type AstraIQSettings struct {
+	Enabled         bool   `json:"enabled"`
+	StartTime       string `json:"start_time"`
+	EndTime         string `json:"end_time"`
+	IntervalMinutes int    `json:"interval_minutes"`
+	StopOnFailure   bool   `json:"stop_on_failure"`
+	// Empty, including settings saved before this field existed, checks every
+	// Astra channel.
+	ChannelIDs []int `json:"channel_ids"`
+}
+
+func DefaultAstraIQSettings() AstraIQSettings {
+	return AstraIQSettings{Enabled: true, StartTime: "00:00", EndTime: "00:00", IntervalMinutes: 5, StopOnFailure: true, ChannelIDs: []int{}}
+}
+
+func (s AstraIQSettings) Validate() error {
+	for _, value := range []string{s.StartTime, s.EndTime} {
+		parsed, err := time.Parse("15:04", value)
+		if err != nil || parsed.Format("15:04") != value {
+			return errors.New("Use HH:mm for check times")
+		}
+	}
+	if s.IntervalMinutes < 1 || s.IntervalMinutes > 1440 {
+		return errors.New("Check interval must be an integer from 1 to 1440")
+	}
+	for _, id := range s.ChannelIDs {
+		if id <= 0 {
+			return errors.New(AstraIQChannelSelectionError)
+		}
+	}
+	return nil
+}
+
+const AstraIQChannelSelectionError = "Select only channels that support the selected model"
+
+// Unselected channels are neither checked nor gated by earlier results.
+func (s AstraIQSettings) Includes(channelID int) bool {
+	return len(s.ChannelIDs) == 0 || slices.Contains(s.ChannelIDs, channelID)
+}
+
+// All nodes use Beijing time. Equal endpoints mean all day; overnight windows
+// belong to the day on which they start. The end boundary is exclusive.
+func (s AstraIQSettings) window(now time.Time) (time.Time, bool) {
+	now = now.In(astraIQTimezone)
+	startClock, _ := time.Parse("15:04", s.StartTime)
+	endClock, _ := time.Parse("15:04", s.EndTime)
+	start := time.Date(now.Year(), now.Month(), now.Day(), startClock.Hour(), startClock.Minute(), 0, 0, astraIQTimezone)
+	end := time.Date(now.Year(), now.Month(), now.Day(), endClock.Hour(), endClock.Minute(), 0, 0, astraIQTimezone)
+	if !end.After(start) {
+		if now.Before(end) {
+			start = start.AddDate(0, 0, -1)
+		} else {
+			end = end.AddDate(0, 0, 1)
+		}
+	}
+	return start, !now.Before(start) && now.Before(end)
+}
+
+func (s AstraIQSettings) Active(now time.Time) bool {
+	_, active := s.window(now)
+	return s.Enabled && active
+}
+
+func (s AstraIQSettings) Due(now, lastRun int64) bool {
+	start, active := s.window(time.Unix(now, 0))
+	return s.Enabled && active && (lastRun == 0 || (s.StartTime != s.EndTime && lastRun < start.Unix()) || now-lastRun >= int64(s.IntervalMinutes)*60)
+}
+
+// Model schedules share one atomic option; older single-model JSON remains Astra.
+type AstraIQConfig struct {
+	Models map[string]AstraIQSettings `json:"model_settings"`
+}
+
+func (c AstraIQConfig) Validate() error {
+	if c.Models == nil {
+		return errors.New("Invalid check settings")
+	}
+	for name, settings := range c.Models {
+		if name == "" || name != strings.TrimSpace(name) || len(name) > 128 || strings.ContainsAny(name, "\r\n\t") {
+			return errors.New("Invalid check model")
+		}
+		if err := settings.Validate(); err != nil {
+			return fmt.Errorf("%s: %w", name, err)
+		}
+	}
+	return nil
+}
+
+func GetAstraIQConfig() (AstraIQConfig, error) {
+	config := AstraIQConfig{Models: map[string]AstraIQSettings{AstraIQModel: DefaultAstraIQSettings()}}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	var option Option
+	result := DB.WithContext(ctx).Where(&Option{Key: astraIQSettingsKey}).Find(&option)
+	if result.Error != nil || result.RowsAffected == 0 {
+		return config, result.Error
+	}
+	var fields map[string]any
+	if err := common.UnmarshalJsonStr(option.Value, &fields); err != nil {
+		return config, err
+	}
+	if _, exists := fields["model_settings"]; exists {
+		config.Models = nil
+		if err := common.UnmarshalJsonStr(option.Value, &config); err != nil {
+			return config, err
+		}
+	} else {
+		legacy := DefaultAstraIQSettings()
+		if err := common.UnmarshalJsonStr(option.Value, &legacy); err != nil {
+			return config, err
+		}
+		config.Models[AstraIQModel] = legacy
+	}
+	return config, config.Validate()
+}
+
+// Omitted model names retain the existing Astra API contract.
+func AstraIQModelName(names ...string) string {
+	if len(names) > 0 && names[0] != "" {
+		return names[0]
+	}
+	return AstraIQModel
+}
+
+func GetAstraIQSettings(names ...string) (AstraIQSettings, error) {
+	config, err := GetAstraIQConfig()
+	settings, selected := config.Models[AstraIQModelName(names...)]
+	if !selected {
+		settings = DefaultAstraIQSettings()
+		settings.Enabled = false
+	}
+	return settings, err
+}
+
+func SaveAstraIQConfig(config AstraIQConfig) error {
+	if err := config.Validate(); err != nil {
+		return err
+	}
+	value, err := common.Marshal(config)
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	return DB.WithContext(ctx).Clauses(clause.OnConflict{
+		Columns: []clause.Column{{Name: "key"}}, DoUpdates: clause.AssignmentColumns([]string{"value"}),
+	}).Create(&Option{Key: astraIQSettingsKey, Value: string(value)}).Error
+}
+
+func SaveAstraIQSettings(settings AstraIQSettings, names ...string) error {
+	config, err := GetAstraIQConfig()
+	if err != nil {
+		return err
+	}
+	config.Models[AstraIQModelName(names...)] = settings
+	return SaveAstraIQConfig(config)
+}
