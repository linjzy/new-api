+}
+
+async function getAstraIQStatus(
+  signal: AbortSignal
+): Promise<AstraIQStatusData> {
+  const response = await api.get<{ success: boolean; data: AstraIQStatusData }>(
+    '/api/channel/astra_iq',
+    { signal }
+  )
+  return requireServerSuccess(response.data).data
+}
+
+// This is a history timeline, not a continuous progress indicator. Each segment
+// represents one probe; the existing Progress component cannot encode outcomes.
+export function AstraIQStatus(props: { channelId: number }) {
+  const { t, i18n } = useTranslation()
+  const query = useQuery({
+    queryKey: ['channels', 'astra-iq'],
+    queryFn: ({ signal }) => getAstraIQStatus(signal),
+    staleTime: 15_000,
+    refetchInterval: 30_000,
+    refetchIntervalInBackground: false,
+    meta: { errorToast: false },
+  })
+  if (query.data?.enabled === false) return null
+  const result = query.data?.results[String(props.channelId)]
+  const history = result?.history?.slice(-24) ?? []
+  const samples: (IQSample | null)[] = [
+    ...Array<null>(24 - history.length).fill(null),
+    ...history,
+  ]
+  const locale = toIntlLocale(i18n.resolvedLanguage || i18n.language)
+  let state = t('Astra IQ pending')
+  if (result?.status === 'pass' && result.allowed) state = t('Astra IQ passed')
+  if (result?.status === 'fail') state = t('Astra IQ wrong answer')
+  if (result?.status === 'error') state = t('Astra IQ request failed')
+  if (result?.status === 'expired') state = t('Astra IQ expired')
+  if (query.isError) state = t('Astra IQ status unavailable')
+  const rate =
+    history.length > 0 ? `${formatNumber(result?.pass_rate, locale)}%` : '—'
+
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={<div tabIndex={0} />}
+        className='min-w-0 space-y-1.5 border-t pt-2'
+        aria-label={`${t('Astra IQ')}: ${state}; ${t('Recent pass rate')}: ${rate}`}
+      >
+        <div className='text-muted-foreground flex items-center justify-between gap-2 text-xs'>
+          <span>{t('Astra IQ')}</span>
+          <span className='font-mono text-sm tabular-nums'>{rate}</span>
+        </div>
+        <div className='flex h-5 gap-0.5' aria-hidden='true'>
+          {samples.map((sample, index) => (
+            <span
+              key={
+                sample
+                  ? String(sample.checked_at)
+                  : `empty-${24 - index}`
+              }
+              className={cn(
+                'h-full min-w-0 flex-1 rounded-full',
+                !sample && 'bg-muted-foreground/20',
+                sample?.status === 'pass' && 'bg-emerald-500',
+                sample?.status === 'fail' && 'bg-red-500',
+                sample?.status === 'error' && 'bg-amber-500'
+              )}
+            />
+          ))}
+        </div>
+        <p
+          className={cn(
+            'text-xs',
+            result?.allowed && !query.isError
+              ? 'text-emerald-700 dark:text-emerald-400'
+              : 'text-muted-foreground'
+          )}
+        >
+          {state}
+        </p>
+      </TooltipTrigger>
+      <TooltipContent role='tooltip' className='block max-w-xs space-y-1'>
+        <p>
+          {t(
+            'Astra IQ checks every 5 minutes at medium reasoning; only the latest passing result permits routing.'
+          )}
+        </p>
+        <p>
+          {t(
+            'Last 24 checks: green passed, red wrong answer, amber error, gray untested.'
+          )}
+        </p>
+        {result?.checked_at ? (
+          <p>
+            {t('Last Tested')}:{' '}
+            {new Date(result.checked_at * 1000).toLocaleString(locale)}
+          </p>
+        ) : null}
+        {result?.answer ? (
+          <p className='break-words'>
+            {t('Latest answer')}: {result.answer}
+          </p>
+        ) : null}
+      </TooltipContent>
+    </Tooltip>
+  )
+}
