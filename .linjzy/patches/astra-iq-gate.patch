+  ['pass', true, 'Astra IQ passed'],
+  ['fail', false, 'Astra IQ wrong answer'],
+  ['error', false, 'Astra IQ request failed'],
+  ['expired', false, 'Astra IQ expired'],
+])(
+  'shows current %s status independently of historical pass rate',
+  (status, allowed, label) => {
+    renderStatus({
