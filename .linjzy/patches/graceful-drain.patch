diff --git a/pkg/drain/drain.go b/pkg/drain/drain.go
new file mode 100644
index 00000000..afe3b304
--- /dev/null
+++ b/pkg/drain/drain.go
@@ -0,0 +1,252 @@
+// Package drain coordinates local deployment admission and connection shutdown.
+package drain
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+)
+
+var Default = New()
+
+type Status struct {
+	Protocol     int    `json:"protocol"`
+	JobID        string `json:"job_id"`
+	Draining     bool   `json:"draining"`
+	HTTPInflight int    `json:"http_inflight"`
+	WSBusy       int    `json:"ws_busy"`
+	WSIdle       int    `json:"ws_idle"`
+	WSClosing    int    `json:"ws_closing"`
+	Ready        bool   `json:"ready"`
+}
+
+type Manager struct {
+	mu       sync.Mutex
+	jobID    string
+	shutdown bool
+	http     int
+	sessions map[*Session]struct{}
+	changed  chan struct{}
+}
+
+type admissionKey struct{}
+type admission struct {
+	manager *Manager
+	active  bool // protected by manager.mu
+}
+
+type Session struct {
+	manager *Manager
+	busy    bool // all session fields are protected by manager.mu
+	closing bool
+	close   func()
+}
+
+func New() *Manager {
+	return &Manager{sessions: make(map[*Session]struct{}), changed: make(chan struct{})}
+}
+
+func (m *Manager) notifyLocked() {
+	close(m.changed)
+	m.changed = make(chan struct{})
+}
+
+func (m *Manager) Status() Status {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	s := Status{Protocol: 1, JobID: m.jobID, Draining: m.jobID != "", HTTPInflight: m.http}
+	for session := range m.sessions {
+		switch {
+		case session.closing:
+			s.WSClosing++
+		case session.busy:
+			s.WSBusy++
+		default:
+			s.WSIdle++
+		}
+	}
+	s.Ready = s.Draining && m.http == 0 && len(m.sessions) == 0
+	return s
+}
+
+// Begin is idempotent for the same job. Idle connections close immediately;
+// busy connections close only after their request worker finishes its output.
+func (m *Manager) Begin(jobID string) error {
+	m.mu.Lock()
+	if jobID == "" || (m.jobID != "" && m.jobID != jobID) || m.shutdown {
+		m.mu.Unlock()
+		return errors.New("drain is owned by another job or shutdown")
+	}
+	callbacks := m.beginLocked(jobID)
+	m.mu.Unlock()
+	for _, closeSession := range callbacks {
+		go closeSession()
+	}
+	return nil
+}
+
+func (m *Manager) beginLocked(jobID string) []func() {
+	m.jobID = jobID
+	var callbacks []func()
+	for session := range m.sessions {
+		if !session.busy && !session.closing {
+			session.closing = true
+			callbacks = append(callbacks, session.close)
+		}
+	}
+	m.notifyLocked()
+	return callbacks
+}
+
+func (m *Manager) Cancel(jobID string) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if jobID == "" || m.jobID != jobID || m.shutdown {
+		return errors.New("drain is owned by another job or shutdown")
+	}
+	m.jobID = ""
+	m.notifyLocked()
+	return nil
+}
+
+func (m *Manager) BeginShutdown() {
+	m.mu.Lock()
+	// Shutdown takes over deployment admission and cannot subsequently be canceled.
+	m.shutdown = true
+	callbacks := m.beginLocked("shutdown")
+	m.mu.Unlock()
+	for _, closeSession := range callbacks {
+		go closeSession()
+	}
+}
+
+func (m *Manager) Wait(ctx context.Context) error {
+	for {
+		m.mu.Lock()
+		ready := m.jobID != "" && m.http == 0 && len(m.sessions) == 0
+		changed := m.changed
+		m.mu.Unlock()
+		if ready {
+			return nil
+		}
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+}
+
+// Wrap holds admission through the entire handler, including settlement defers.
+// Health checks remain available and are excluded from the business counters.
+func (m *Manager) Wrap(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/api/status" && (r.Method == http.MethodGet || r.Method == http.MethodHead) {
+			next.ServeHTTP(w, r)
+			return
+		}
+		m.mu.Lock()
+		if m.jobID != "" {
+			m.mu.Unlock()
+			w.Header().Set("Retry-After", "5")
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusServiceUnavailable)
+			_, _ = w.Write([]byte(`{"error":{"message":"service restarting; retry later","type":"service_unavailable","code":"service_draining"}}`))
+			return
+		}
+		m.http++
+		a := &admission{manager: m, active: true}
+		m.notifyLocked()
+		m.mu.Unlock()
+		defer func() {
+			m.mu.Lock()
+			if a.active {
+				m.http--
+				a.active = false
+				m.notifyLocked()
+			}
+			m.mu.Unlock()
+		}()
+		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), admissionKey{}, a)))
+	})
+}
+
+// RegisterWS atomically transfers the HTTP handshake admission to a session.
+// The continuous realtime protocol stays busy for its complete lifetime: it has
+// no universally safe request boundary, so deployments wait instead of cutting it.
+func RegisterWS(ctx context.Context, busy bool, closeSession func()) *Session {
+	m := Default
+	a, _ := ctx.Value(admissionKey{}).(*admission)
+	if a != nil {
+		m = a.manager
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.jobID != "" {
+		return nil
+	}
+	if a != nil && a.active {
+		a.active = false
+		m.http--
+	}
+	s := &Session{manager: m, busy: busy, close: closeSession}
+	m.sessions[s] = struct{}{}
+	m.notifyLocked()
+	return s
+}
+
+// StartWork shares the admission lock with Begin, so a successful idle
+// observation can never race a new response.create into the upstream.
+func (s *Session) StartWork() bool {
+	if s == nil {
+		return true
+	}
+	m := s.manager
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if _, exists := m.sessions[s]; !exists || m.jobID != "" || s.closing || s.busy {
+		return false
+	}
+	s.busy = true
+	m.notifyLocked()
+	return true
+}
+
+func (s *Session) Draining() bool {
+	if s == nil {
+		return false
+	}
+	s.manager.mu.Lock()
+	defer s.manager.mu.Unlock()
+	return s.manager.jobID != "" || s.closing
+}
+
+func (s *Session) FinishWork() {
+	if s == nil {
+		return
+	}
+	m := s.manager
+	m.mu.Lock()
+	s.busy = false
+	closeNow := m.jobID != "" && !s.closing
+	if closeNow {
+		s.closing = true
+	}
+	m.notifyLocked()
+	m.mu.Unlock()
+	if closeNow {
+		s.close()
+	}
+}
+
+func (s *Session) Unregister() {
+	if s == nil {
+		return
+	}
+	m := s.manager
+	m.mu.Lock()
+	delete(m.sessions, s)
+	m.notifyLocked()
+	m.mu.Unlock()
+}
diff --git a/pkg/drain/control.go b/pkg/drain/control.go
new file mode 100644
index 00000000..2c159c79
--- /dev/null
+++ b/pkg/drain/control.go
@@ -0,0 +1,132 @@
+package drain
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+const SocketPath = "/tmp/newapi-drain/control.sock"
+
+var validJobID = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$`)
+
+// ControlHandler is served only on a mode-0600 Unix socket, never on the public
+// router. Docker exec grants the host operator access without an API credential.
+func (m *Manager) ControlHandler() http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Cache-Control", "no-store")
+		status := http.StatusOK
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/status":
+		case r.Method == http.MethodPost && (r.URL.Path == "/begin" || r.URL.Path == "/cancel"):
+			job := r.URL.Query().Get("job")
+			if !validJobID.MatchString(job) || job == "shutdown" {
+				http.Error(w, "invalid drain job", http.StatusBadRequest)
+				return
+			}
+			var err error
+			if r.URL.Path == "/begin" {
+				err = m.Begin(job)
+			} else {
+				err = m.Cancel(job)
+			}
+			if err != nil {
+				status = http.StatusConflict
+			}
+		default:
+			http.Error(w, "unsupported drain operation", http.StatusMethodNotAllowed)
+			return
+		}
+		payload, err := common.Marshal(m.Status())
+		if err != nil {
+			http.Error(w, "cannot encode drain status", http.StatusInternalServerError)
+			return
+		}
+		w.WriteHeader(status)
+		_, _ = w.Write(payload)
+	})
+}
+
+func (m *Manager) StartControl(path string) (func(), error) {
+	dir := filepath.Dir(path)
+	if err := os.Mkdir(dir, 0700); err != nil && !os.IsExist(err) {
+		return nil, err
+	}
+	info, err := os.Lstat(dir)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
+		return nil, errors.New("drain control directory must be private")
+	}
+	if info, err := os.Lstat(path); err == nil {
+		if info.Mode()&os.ModeSocket == 0 {
+			return nil, errors.New("drain control path is not a socket")
+		}
+		conn, dialErr := net.DialTimeout("unix", path, time.Second)
+		if dialErr == nil {
+			_ = conn.Close()
+			return nil, errors.New("drain control socket is already active")
+		}
+		if err := os.Remove(path); err != nil {
+			return nil, err
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(path, 0600); err != nil {
+		_ = listener.Close()
+		return nil, err
+	}
+	server := &http.Server{Handler: m.ControlHandler(), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second}
+	go func() { _ = server.Serve(listener) }()
+	return func() { _ = server.Close() }, nil
+}
+
+func RunCLI(args []string) int {
+	if len(args) == 0 || (args[0] != "status" && args[0] != "begin" && args[0] != "cancel") ||
+		(args[0] == "status" && len(args) != 1) || (args[0] != "status" && (len(args) != 2 || !validJobID.MatchString(args[1]))) {
+		fmt.Fprintln(os.Stderr, "usage: new-api drain status | begin JOB_ID | cancel JOB_ID")
+		return 2
+	}
+	method, target := http.MethodGet, "http://unix/status"
+	if args[0] != "status" {
+		method, target = http.MethodPost, "http://unix/"+args[0]+"?job="+url.QueryEscape(args[1])
+	}
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", SocketPath)
+	}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Second}
+	request, _ := http.NewRequest(method, target, nil)
+	response, err := client.Do(request)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "drain control unavailable:", err)
+		return 1
+	}
+	defer response.Body.Close()
+	payload, err := io.ReadAll(io.LimitReader(response.Body, 16*1024))
+	if err != nil || response.StatusCode != http.StatusOK {
+		fmt.Fprintln(os.Stderr, "drain control rejected operation:", response.Status)
+		return 1
+	}
+	var status Status
+	if common.Unmarshal(payload, &status) != nil || status.Protocol != 1 {
+		fmt.Fprintln(os.Stderr, "invalid drain control response")
+		return 1
+	}
+	fmt.Println(string(payload))
+	return 0
+}
