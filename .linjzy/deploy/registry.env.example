NEWAPI_IMAGE_REPOSITORY=ghcr.io/linjzy/new-api
NEWAPI_SOURCE_REPOSITORY=linjzy/new-api
NEWAPI_CANDIDATE_TAG=candidate
# Enable post-deployment branch cleanup with a private Actions:write token file.
# NEWAPI_GITHUB_TOKEN_FILE=/opt/new-api/custom/github-actions.token
# Put runtime overrides here so the detached worker reads the same values.
# NEWAPI_DRAIN_WAIT_SECONDS=600
# NEWAPI_HEALTH_TIMEOUT_SECONDS=180
